{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-phone-agent-computerchloefloat",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AGENT_TOKEN": "ftyhv012"
  },
  "durable_objects": {
    "bindings": [{ "class_name": "Computer", "name": "Computer" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Computer"] }
  ]
}
